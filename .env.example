# Safe application environment label.
BTLS_APP_ENV=development

# Canonical application URL. Configure every environment's URL in Supabase Auth Redirect URLs.
BTLS_APP_URL=http://127.0.0.1:3000

# Supabase browser-safe configuration. Leave unset until a local or hosted project is available.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only infrastructure configuration. Never expose these values to browser code.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_DATABASE_URL=

# Durable jobs. Both values are required in hosted environments.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Transactional provider credentials. Postmark is outbound-only; Twilio uses a Messaging Service.
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=

# Error monitoring and structured server logs. Never expose the auth token.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_RELEASE=
BTLS_LOG_LEVEL=info

# Enables the existing manual Feature 06 cleanup command when set to enabled.
BTLS_INTERNAL_MAINTENANCE=

# Pending BTLS authorization invitation lifetime in hours (1-168).
BTLS_PENDING_INVITATION_EXPIRY_HOURS=24

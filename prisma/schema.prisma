generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AppUserStatus {
  ACTIVE
  DISABLED
}

enum PlatformRole {
  BTLS_ADMIN
  BTLS_OPERATOR
}

enum AccountRole {
  CLIENT_OWNER
  CLIENT_MANAGER
  CLIENT_STAFF
  CLIENT_VIEWER
}

enum AccountMembershipStatus {
  ACTIVE
  SUSPENDED
}

enum ClientAccountStatus {
  ACTIVE
  SUSPENDED
}

enum ClientPropertyStatus {
  ACTIVE
  SUSPENDED
}

enum FeatureFlagScope {
  GLOBAL
  ACCOUNT
  PROPERTY
}

enum PendingInvitationStatus {
  PENDING
  CANCELLED
  EXPIRED
  APPLIED
}

/// Server-owned storage profile. This classifies Storage behavior only; it is not a domain owner.
enum MediaAssetProfile {
  BRAND_IMAGE
  CONTENT_IMAGE
  ATTACHMENT
  EVIDENCE
  GENERATED_DOCUMENT
  TEMPORARY_INPUT
}

enum MediaVisibility {
  PUBLIC
  PRIVATE
}

enum MediaSensitivity {
  NORMAL
  SENSITIVE
}

enum MediaDurability {
  DURABLE
  TEMPORARY
}

enum MediaStorageBucket {
  PUBLIC_MEDIA
  PUBLIC_CONTENT
  PRIVATE_MEDIA
  TEMPORARY_UPLOADS
}

/// Byte lifecycle only. Library removal/visibility is tracked separately by removedAt.
enum MediaAssetStatus {
  PENDING_UPLOAD
  READY
  DELETION_PENDING
  DELETED
}

model AppUser {
  /// Must equal the corresponding Supabase auth.users UUID.
  id           String        @id @db.Uuid
  email        String        @unique
  displayName  String?       @map("display_name")
  status       AppUserStatus @default(ACTIVE)
  platformRole PlatformRole? @map("platform_role")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  employeeProfiles   EmployeeProfile[]
  accountMemberships AccountMembership[]
  auditEvents        AuditEvent[]               @relation("AuditEventActor")
  sentInvitations    PendingAccountInvitation[] @relation("PendingInvitationInviter")

  createdMediaAssets     MediaAsset[]   @relation("MediaAssetCreator")
  notifications          Notification[] @relation("NotificationRecipient")
  initiatedJobExecutions JobExecution[] @relation("JobExecutionInitiator")

  @@map("app_users")
}

model ClientAccount {
  id        String              @id @default(uuid()) @db.Uuid
  name      String
  status    ClientAccountStatus @default(ACTIVE)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  properties         ClientProperty[]
  memberships        AccountMembership[]
  featureFlags       FeatureFlag[]
  auditEvents        AuditEvent[]
  pendingInvitations PendingAccountInvitation[]

  @@index([status])
  @@map("client_accounts")
}

model ClientProperty {
  id        String               @id @default(uuid()) @db.Uuid
  accountId String               @map("account_id") @db.Uuid
  name      String
  domain    String?              @unique
  status    ClientPropertyStatus @default(ACTIVE)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  account          ClientAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  propertyAccesses PropertyAccess[]
  featureFlags     FeatureFlag[]
  auditEvents      AuditEvent[]
  pendingAccesses  PendingPropertyAccess[]

  mediaAssets        MediaAsset[]
  eventOutboxEntries EventOutbox[]
  jobExecutions      JobExecution[]
  notifications      Notification[]
  webhookReceipts    WebhookReceipt[]
  customers          Customer[]
  contacts           Contact[]
  serviceLocations   ServiceLocation[]
  serviceAssets      ServiceAsset[]
  tags               Tag[]
  customerTags       CustomerTag[]
  employeeProfiles   EmployeeProfile[]
  revenueSettings    RevenueOperationsSettings?
  propertyServices   PropertyService[]
  sendingIdentities  SendingIdentity[]
  providerDispatches ProviderDispatch[]

  @@unique([id, accountId])
  @@index([accountId, status])
  @@map("client_properties")
}

model AccountMembership {
  id        String                  @id @default(uuid()) @db.Uuid
  accountId String                  @map("account_id") @db.Uuid
  userId    String                  @map("user_id") @db.Uuid
  role      AccountRole
  status    AccountMembershipStatus @default(ACTIVE)
  createdAt DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  account          ClientAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  user             AppUser          @relation(fields: [userId], references: [id], onDelete: Restrict)
  propertyAccesses PropertyAccess[]

  @@unique([userId, accountId])
  @@unique([id, accountId])
  @@index([accountId, status])
  @@index([userId, status])
  @@map("account_memberships")
}

model PropertyAccess {
  id           String       @id @default(uuid()) @db.Uuid
  accountId    String       @map("account_id") @db.Uuid
  membershipId String       @map("membership_id") @db.Uuid
  propertyId   String       @map("property_id") @db.Uuid
  roleOverride AccountRole? @map("role_override")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  membership AccountMembership @relation(fields: [membershipId, accountId], references: [id, accountId], onDelete: Cascade)
  property   ClientProperty    @relation(fields: [propertyId, accountId], references: [id, accountId], onDelete: Cascade)

  @@unique([membershipId, propertyId])
  @@index([propertyId])
  @@index([membershipId])
  @@map("property_accesses")
}

/// Authorization intended for an invited Auth identity before it has a verified AppUser profile.
/// The invited user ID is intentionally not a foreign key because Feature 04 creates AppUser only
/// after Supabase verifies and accepts the invitation.
model PendingAccountInvitation {
  id            String                  @id @default(uuid()) @db.Uuid
  accountId     String                  @map("account_id") @db.Uuid
  invitedUserId String                  @map("invited_user_id") @db.Uuid
  email         String
  role          AccountRole
  status        PendingInvitationStatus @default(PENDING)
  expiresAt     DateTime                @map("expires_at") @db.Timestamptz(6)
  invitedById   String                  @map("invited_by_id") @db.Uuid
  appliedAt     DateTime?               @map("applied_at") @db.Timestamptz(6)
  cancelledAt   DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  account        ClientAccount           @relation(fields: [accountId], references: [id], onDelete: Restrict)
  invitedBy      AppUser                 @relation("PendingInvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  propertyGrants PendingPropertyAccess[]

  @@unique([id, accountId])
  @@unique([invitedUserId, accountId])
  @@index([accountId, status])
  @@index([invitedUserId, status])
  @@index([expiresAt])
  @@map("pending_account_invitations")
}

model PendingPropertyAccess {
  id                  String       @id @default(uuid()) @db.Uuid
  accountId           String       @map("account_id") @db.Uuid
  pendingInvitationId String       @map("pending_invitation_id") @db.Uuid
  propertyId          String       @map("property_id") @db.Uuid
  roleOverride        AccountRole? @map("role_override")
  createdAt           DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  pendingInvitation PendingAccountInvitation @relation(fields: [pendingInvitationId, accountId], references: [id, accountId], onDelete: Cascade)
  property          ClientProperty           @relation(fields: [propertyId, accountId], references: [id, accountId], onDelete: Cascade)

  @@unique([pendingInvitationId, propertyId])
  @@index([propertyId])
  @@map("pending_property_accesses")
}

model FeatureFlag {
  id         String           @id @default(uuid()) @db.Uuid
  key        String
  enabled    Boolean          @default(false)
  scope      FeatureFlagScope
  accountId  String?          @map("account_id") @db.Uuid
  propertyId String?          @map("property_id") @db.Uuid
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  account  ClientAccount?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  property ClientProperty? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([propertyId])
  @@map("feature_flags")
}

/// Shared property-scoped stored-file lifecycle. Owning feature relationships are intentionally
/// absent: future features add their own explicit MediaAsset foreign keys.
model MediaAsset {
  id                         String             @id @default(uuid()) @db.Uuid
  propertyId                 String             @map("property_id") @db.Uuid
  createdById                String?            @map("created_by_id") @db.Uuid
  replacesAssetId            String?            @map("replaces_asset_id") @db.Uuid
  profile                    MediaAssetProfile
  visibility                 MediaVisibility
  sensitivity                MediaSensitivity
  durability                 MediaDurability
  storageBucket              MediaStorageBucket @map("storage_bucket")
  pathFamily                 String             @map("path_family")
  targetKey                  String?            @map("target_key")
  objectPath                 String             @map("object_path")
  displayFilename            String             @map("display_filename")
  declaredMimeType           String             @map("declared_mime_type")
  declaredByteSize           Int                @map("declared_byte_size")
  expectedExtension          String             @map("expected_extension")
  verifiedMimeType           String?            @map("verified_mime_type")
  verifiedByteSize           Int?               @map("verified_byte_size")
  verifiedExtension          String?            @map("verified_extension")
  storageObjectId            String?            @map("storage_object_id")
  storageObjectVersion       String?            @map("storage_object_version")
  storageEtag                String?            @map("storage_etag")
  status                     MediaAssetStatus   @default(PENDING_UPLOAD)
  uploadUrlExpiresAt         DateTime           @map("upload_url_expires_at") @db.Timestamptz(6)
  finalizationDeadlineAt     DateTime           @map("finalization_deadline_at") @db.Timestamptz(6)
  finalizedAt                DateTime?          @map("finalized_at") @db.Timestamptz(6)
  expiresAt                  DateTime?          @map("expires_at") @db.Timestamptz(6)
  removedAt                  DateTime?          @map("removed_at") @db.Timestamptz(6)
  cleanupEligibleAt          DateTime?          @map("cleanup_eligible_at") @db.Timestamptz(6)
  deletionClaimId            String?            @map("deletion_claim_id") @db.Uuid
  deletionClaimedAt          DateTime?          @map("deletion_claimed_at") @db.Timestamptz(6)
  deletionLeaseExpiresAt     DateTime?          @map("deletion_lease_expires_at") @db.Timestamptz(6)
  deletionAttemptCount       Int                @default(0) @map("deletion_attempt_count")
  finalizationAttemptCount   Int                @default(0) @map("finalization_attempt_count")
  lastFinalizationAttemptAt  DateTime?          @map("last_finalization_attempt_at") @db.Timestamptz(6)
  lastFailureCategory        String?            @map("last_failure_category")
  lastFailureAt              DateTime?          @map("last_failure_at") @db.Timestamptz(6)
  lastCleanupFailureCategory String?            @map("last_cleanup_failure_category")
  lastCleanupFailureAt       DateTime?          @map("last_cleanup_failure_at") @db.Timestamptz(6)
  deletedAt                  DateTime?          @map("deleted_at") @db.Timestamptz(6)
  createdAt                  DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  property      ClientProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  createdBy     AppUser?       @relation("MediaAssetCreator", fields: [createdById], references: [id], onDelete: SetNull)
  replacesAsset MediaAsset?    @relation("MediaAssetReplacement", fields: [replacesAssetId], references: [id], onDelete: Restrict)
  replacements  MediaAsset[]   @relation("MediaAssetReplacement")

  @@unique([storageBucket, objectPath])
  @@index([propertyId, profile, status, removedAt, createdAt])
  @@index([status, cleanupEligibleAt, deletionLeaseExpiresAt])
  @@index([propertyId, status, finalizationDeadlineAt])
  @@index([replacesAssetId])
  @@map("media_assets")
}

/// Append-only: application services must not update or delete audit events.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorId     String?  @map("actor_id") @db.Uuid
  accountId   String?  @map("account_id") @db.Uuid
  propertyId  String?  @map("property_id") @db.Uuid
  action      String
  subjectType String   @map("subject_type")
  subjectId   String?  @map("subject_id")
  metadata    Json?
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  actor    AppUser?        @relation("AuditEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  account  ClientAccount?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  property ClientProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@index([actorId, occurredAt])
  @@index([accountId, occurredAt])
  @@index([propertyId, occurredAt])
  @@map("audit_events")
}

enum EventOutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

enum JobExecutionOrigin {
  USER
  SYSTEM
  WEBHOOK
}

enum JobExecutionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  RETRY_SCHEDULED
}

enum JobExecutionAttemptStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum WebhookProvider {
  POSTMARK
  TWILIO
}

enum WebhookReceiptStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
}

enum SendingIdentityMode {
  BTLS_MANAGED
  CUSTOM_DOMAIN
  CONNECTED_MAILBOX
}

enum SendingIdentityStatus {
  ACTIVE
  DISABLED
}

enum ProviderDispatchChannel {
  TRANSACTIONAL_EMAIL
  SMS
}

enum ProviderDispatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  UNCERTAIN
  FAILED
}

/// A committed internal event that awaits dispatch. The originating business record remains the source of truth.
model EventOutbox {
  id               String            @id @default(uuid()) @db.Uuid
  propertyId       String            @map("property_id") @db.Uuid
  eventId          String            @unique @map("event_id") @db.Uuid
  eventName        String            @map("event_name")
  eventVersion     Int               @map("event_version")
  correlationId    String            @map("correlation_id") @db.Uuid
  deduplicationKey String            @map("deduplication_key")
  payload          Json
  status           EventOutboxStatus @default(PENDING)
  dispatchedAt     DateTime?         @map("dispatched_at") @db.Timestamptz(6)
  failureCategory  String?           @map("failure_category")
  failureAt        DateTime?         @map("failure_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  property ClientProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([propertyId, eventName, deduplicationKey])
  @@index([status, createdAt])
  @@index([propertyId, createdAt])
  @@map("event_outbox")
}

/// Operational execution visibility only. It does not replace any owning business record.
model JobExecution {
  id               String             @id @default(uuid()) @db.Uuid
  propertyId       String             @map("property_id") @db.Uuid
  initiatedById    String?            @map("initiated_by_id") @db.Uuid
  jobType          String             @map("job_type")
  jobVersion       Int                @map("job_version")
  origin           JobExecutionOrigin
  status           JobExecutionStatus @default(QUEUED)
  correlationId    String             @map("correlation_id") @db.Uuid
  idempotencyKey   String             @map("idempotency_key")
  safePayload      Json               @map("safe_payload")
  retryRequestedAt DateTime?          @map("retry_requested_at") @db.Timestamptz(6)
  startedAt        DateTime?          @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime?          @map("finished_at") @db.Timestamptz(6)
  failureCategory  String?            @map("failure_category")
  failureMessage   String?            @map("failure_message")
  failedAt         DateTime?          @map("failed_at") @db.Timestamptz(6)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  property    ClientProperty        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  initiatedBy AppUser?              @relation("JobExecutionInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  attempts    JobExecutionAttempt[]
  dispatches  ProviderDispatch[]

  @@unique([propertyId, jobType, idempotencyKey])
  @@index([propertyId, status, createdAt])
  @@index([status, failedAt])
  @@index([correlationId])
  @@map("job_executions")
}

model JobExecutionAttempt {
  id              String                    @id @default(uuid()) @db.Uuid
  jobExecutionId  String                    @map("job_execution_id") @db.Uuid
  attemptNumber   Int                       @map("attempt_number")
  status          JobExecutionAttemptStatus @default(STARTED)
  providerRunId   String?                   @map("provider_run_id")
  startedAt       DateTime                  @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt      DateTime?                 @map("finished_at") @db.Timestamptz(6)
  failureCategory String?                   @map("failure_category")
  failureMessage  String?                   @map("failure_message")

  jobExecution JobExecution @relation(fields: [jobExecutionId], references: [id], onDelete: Cascade)

  @@unique([jobExecutionId, attemptNumber])
  @@index([status, startedAt])
  @@map("job_execution_attempts")
}

/// Persistent in-app notice. Its typed subject link is validated by the application service.
model Notification {
  id               String    @id @default(uuid()) @db.Uuid
  propertyId       String    @map("property_id") @db.Uuid
  recipientUserId  String    @map("recipient_user_id") @db.Uuid
  source           String?
  correlationId    String?   @map("correlation_id") @db.Uuid
  type             String
  title            String
  body             String
  subjectType      String?   @map("subject_type")
  subjectId        String?   @map("subject_id") @db.Uuid
  deduplicationKey String    @map("deduplication_key")
  readAt           DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  property  ClientProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  recipient AppUser        @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Restrict)

  @@unique([propertyId, recipientUserId, deduplicationKey])
  @@index([propertyId, recipientUserId, readAt, createdAt])
  @@map("notifications")
}

/// Provider callback receipt and duplicate-processing evidence. It never becomes business delivery truth.
model WebhookReceipt {
  id                  String               @id @default(uuid()) @db.Uuid
  propertyId          String?              @map("property_id") @db.Uuid
  provider            WebhookProvider
  providerAccountKey  String               @map("provider_account_key")
  externalEventId     String               @map("external_event_id")
  eventType           String               @map("event_type")
  correlationId       String?              @map("correlation_id") @db.Uuid
  occurredAt          DateTime?            @map("occurred_at") @db.Timestamptz(6)
  status              WebhookReceiptStatus @default(RECEIVED)
  processingStartedAt DateTime?            @map("processing_started_at") @db.Timestamptz(6)
  processedAt         DateTime?            @map("processed_at") @db.Timestamptz(6)
  failureCategory     String?              @map("failure_category")
  failureAt           DateTime?            @map("failure_at") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  property ClientProperty? @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountKey, externalEventId])
  @@index([propertyId, createdAt])
  @@index([status, createdAt])
  @@map("webhook_receipts")
}

/// Shared transactional sender configuration. Feature 07 supports BTLS_MANAGED behavior only.
model SendingIdentity {
  id             String                @id @default(uuid()) @db.Uuid
  propertyId     String                @map("property_id") @db.Uuid
  mode           SendingIdentityMode   @default(BTLS_MANAGED)
  status         SendingIdentityStatus @default(ACTIVE)
  displayName    String                @map("display_name")
  fromAddress    String                @map("from_address")
  replyToAddress String?               @map("reply_to_address")
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        ClientProperty              @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  dispatches      ProviderDispatch[]
  revenueSettings RevenueOperationsSettings[]

  @@unique([id, propertyId])
  @@index([propertyId, status])
  @@map("sending_identities")
}

/// Outbound transport acceptance, idempotency, and correlation evidence only. Owning domains create delivery truth.
model ProviderDispatch {
  id                    String                  @id @default(uuid()) @db.Uuid
  propertyId            String                  @map("property_id") @db.Uuid
  jobExecutionId        String?                 @map("job_execution_id") @db.Uuid
  sendingIdentityId     String?                 @map("sending_identity_id") @db.Uuid
  channel               ProviderDispatchChannel
  providerName          String                  @map("provider_name")
  operationType         String                  @map("operation_type")
  idempotencyKey        String                  @map("idempotency_key")
  correlationId         String                  @map("correlation_id") @db.Uuid
  providerCorrelationId String?                 @map("provider_correlation_id")
  providerMessageId     String?                 @map("provider_message_id")
  status                ProviderDispatchStatus  @default(PENDING)
  requestFingerprint    String                  @map("request_fingerprint")
  acceptedAt            DateTime?               @map("accepted_at") @db.Timestamptz(6)
  completedAt           DateTime?               @map("completed_at") @db.Timestamptz(6)
  failureCategory       String?                 @map("failure_category")
  failureAt             DateTime?               @map("failure_at") @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  property        ClientProperty   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  jobExecution    JobExecution?    @relation(fields: [jobExecutionId], references: [id], onDelete: SetNull)
  sendingIdentity SendingIdentity? @relation(fields: [sendingIdentityId], references: [id], onDelete: SetNull)

  @@unique([propertyId, channel, operationType, idempotencyKey])
  @@index([propertyId, status, createdAt])
  @@index([providerName, providerMessageId])
  @@index([correlationId])
  @@map("provider_dispatches")
}

enum CustomerRelationshipState {
  PROSPECT
  CURRENT
  INACTIVE
}

model PropertyService {
  id              String            @id @default(uuid()) @db.Uuid
  propertyId      String            @map("property_id") @db.Uuid
  name            String
  normalizedName  String            @map("normalized_name")
  slug            String
  parentServiceId String?           @map("parent_service_id") @db.Uuid
  isActive        Boolean           @default(true) @map("is_active")
  revision        Int               @default(1)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  property        ClientProperty    @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  parent          PropertyService?  @relation("ServiceHierarchy", fields: [parentServiceId, propertyId], references: [id, propertyId], onDelete: Restrict)
  children        PropertyService[] @relation("ServiceHierarchy")

  @@unique([id, propertyId])
  @@unique([propertyId, normalizedName])
  @@unique([propertyId, slug])
  @@index([propertyId, isActive, name, id])
  @@map("property_services")
}

model Customer {
  id                String                    @id @default(uuid()) @db.Uuid
  propertyId        String                    @map("property_id") @db.Uuid
  displayName       String                    @map("display_name")
  normalizedName    String                    @map("normalized_name")
  relationshipState CustomerRelationshipState @default(PROSPECT) @map("relationship_state")
  revision          Int                       @default(1)
  createRequestId   String                    @map("create_request_id") @db.Uuid
  createActorId     String                    @map("create_actor_id") @db.Uuid
  createFingerprint String                    @map("create_fingerprint")
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  property          ClientProperty            @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  contacts          Contact[]
  locations         ServiceLocation[]
  assets            ServiceAsset[]
  tags              CustomerTag[]

  @@unique([id, propertyId])
  @@unique([propertyId, createActorId, createRequestId])
  @@index([propertyId, relationshipState, displayName, id])
  @@index([propertyId, normalizedName])
  @@map("customers")
}

model Contact {
  id              String         @id @default(uuid()) @db.Uuid
  propertyId      String         @map("property_id") @db.Uuid
  customerId      String         @map("customer_id") @db.Uuid
  personName      String         @map("person_name")
  email           String?
  normalizedEmail String?        @map("normalized_email")
  phoneE164       String?        @map("phone_e164")
  phoneDisplay    String?        @map("phone_display")
  isPrimary       Boolean        @default(false) @map("is_primary")
  isActive        Boolean        @default(true) @map("is_active")
  revision        Int            @default(1)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  property        ClientProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  customer        Customer       @relation(fields: [customerId, propertyId], references: [id, propertyId], onDelete: Restrict)

  @@unique([id, propertyId, customerId])
  @@index([propertyId, customerId, isActive])
  @@index([propertyId, normalizedEmail])
  @@index([propertyId, phoneE164])
  @@map("contacts")
}

model ServiceLocation {
  id           String         @id @default(uuid()) @db.Uuid
  propertyId   String         @map("property_id") @db.Uuid
  customerId   String         @map("customer_id") @db.Uuid
  name         String
  addressLine1 String         @map("address_line_1")
  addressLine2 String?        @map("address_line_2")
  locality     String
  region       String?
  postalCode   String?        @map("postal_code")
  countryCode  String         @map("country_code") @db.VarChar(2)
  isDefault    Boolean        @default(false) @map("is_default")
  isActive     Boolean        @default(true) @map("is_active")
  revision     Int            @default(1)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  property     ClientProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  customer     Customer       @relation(fields: [customerId, propertyId], references: [id, propertyId], onDelete: Restrict)
  assets       ServiceAsset[]

  @@unique([id, propertyId, customerId])
  @@index([propertyId, customerId, isActive])
  @@map("service_locations")
}

model ServiceAsset {
  id                String           @id @default(uuid()) @db.Uuid
  propertyId        String           @map("property_id") @db.Uuid
  customerId        String           @map("customer_id") @db.Uuid
  serviceLocationId String?          @map("service_location_id") @db.Uuid
  name              String
  manufacturer      String?
  modelName         String?          @map("model_name")
  serialNumber      String?          @map("serial_number")
  isActive          Boolean          @default(true) @map("is_active")
  revision          Int              @default(1)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  property          ClientProperty   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  customer          Customer         @relation(fields: [customerId, propertyId], references: [id, propertyId], onDelete: Restrict)
  location          ServiceLocation? @relation(fields: [serviceLocationId, propertyId, customerId], references: [id, propertyId, customerId], onDelete: Restrict)

  @@unique([id, propertyId])
  @@index([propertyId, customerId, isActive])
  @@map("service_assets")
}

model Tag {
  id             String         @id @default(uuid()) @db.Uuid
  propertyId     String         @map("property_id") @db.Uuid
  name           String
  normalizedName String         @map("normalized_name")
  isActive       Boolean        @default(true) @map("is_active")
  revision       Int            @default(1)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  property       ClientProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  assignments    CustomerTag[]

  @@unique([id, propertyId])
  @@unique([propertyId, normalizedName])
  @@map("tags")
}

model CustomerTag {
  propertyId String         @map("property_id") @db.Uuid
  customerId String         @map("customer_id") @db.Uuid
  tagId      String         @map("tag_id") @db.Uuid
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  property   ClientProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  customer   Customer       @relation(fields: [customerId, propertyId], references: [id, propertyId], onDelete: Restrict)
  tag        Tag            @relation(fields: [tagId, propertyId], references: [id, propertyId], onDelete: Restrict)

  @@id([propertyId, customerId, tagId])
  @@index([propertyId, tagId])
  @@map("customer_tags")
}

model EmployeeProfile {
  id          String         @id @default(uuid()) @db.Uuid
  propertyId  String         @map("property_id") @db.Uuid
  appUserId   String?        @map("app_user_id") @db.Uuid
  displayName String         @map("display_name")
  jobTitle    String?        @map("job_title")
  isActive    Boolean        @default(true) @map("is_active")
  revision    Int            @default(1)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  property    ClientProperty @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  user        AppUser?       @relation(fields: [appUserId], references: [id], onDelete: Restrict)

  @@unique([id, propertyId])
  @@unique([propertyId, appUserId])
  @@index([propertyId, isActive, displayName, id])
  @@map("employee_profiles")
}

model RevenueOperationsSettings {
  propertyId               String           @id @map("property_id") @db.Uuid
  defaultSendingIdentityId String?          @map("default_sending_identity_id") @db.Uuid
  reviewRequestDelayDays   Int?             @map("review_request_delay_days")
  revision                 Int              @default(1)
  createdAt                DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  property                 ClientProperty   @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  sendingIdentity          SendingIdentity? @relation(fields: [defaultSendingIdentityId, propertyId], references: [id, propertyId], onDelete: Restrict)

  @@map("revenue_operations_settings")
}
